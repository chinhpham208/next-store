{
  "name": "next-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run db:migrate && (test \"$VERCEL_ENV\" = production || npm run db:seed) && next build",
    "start": "next start",
    "smoke": "bash scripts/smoke.sh",
    "test:scripts": "bash scripts/smoke.test.sh && python3 -m unittest discover -s scripts/youtrack -p 'test_*.py'",
    "e2e": "playwright test",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint && npm run check:deps && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server src/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server src/db/seed.ts",
    "db:seed:sql": "tsx scripts/seed-sql.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "prebuild": "npm run db:setup"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
