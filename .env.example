# Sao chép thành .env.local rồi điền giá trị. Không commit .env.local.

# Local: sao chép thành .env.local. Preview / production: đặt trong Vercel → Settings → Environment Variables.

# --- Database -----------------------------------------------------------
# Bỏ trống: dùng PGlite, dữ liệu lưu trong .data/pglite (không cần cài gì).
# Có giá trị: dùng Postgres thật. Ví dụ: postgres://user:pass@localhost:5432/next_store
DATABASE_URL=

# Chỉ db:migrate dùng (kết nối trực tiếp, không qua pooler); tích hợp Neon tự đặt. Bỏ trống: dùng DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Endpoint id của Neon branch production (dạng ep-…, viết thường, không có -pooler, không có tên miền). Không bí mật.
# Chỉ được kiểm khi chạy trên Vercel (VERCEL có giá trị): bắt buộc ở preview / development — thiếu hoặc trùng
# endpoint của DATABASE_URL thì từ chối kết nối; ở production có thì phải khớp. Sai dạng: mọi environment từ chối.
# Trên Vercel đặt một mục duy nhất chọn cả ba environment. Local: bỏ trống.
NEON_PRODUCTION_ENDPOINT=

# Role app next_store_app (chỉ DML) cho runtime, prerender và db:seed; db:migrate luôn dùng role trong DATABASE_URL.
# Host, cổng, database lấy từ DATABASE_URL; chỉ user (phải đúng next_store_app) và mật khẩu lấy ở đây. Đặt cả hai hoặc bỏ trống cả hai
# (bỏ trống: dùng role của DATABASE_URL). Vercel: chủ dự án đặt, Sensitive (README, mục "Role app"). Local: bỏ trống.
DATABASE_APP_USER=
DATABASE_APP_PASSWORD=

# Thư mục dữ liệu PGlite. "memory://" để chạy trong bộ nhớ (test dùng giá trị này).
# Mặc định: .data/pglite
PGLITE_DATA_DIR=

# 1 = in mọi câu SQL ra terminal (gỡ lỗi truy vấn).
# Bị từ chối trên database production: log có cả tham số truy vấn (dữ liệu khách hàng). Chỉ chạy với PGlite,
# Postgres trên localhost, hoặc trên Vercel với VERCEL_ENV=preview / development; mọi trường hợp khác dừng trước
# khi kết nối. Không bật trên Preview / Dev cho tới khi preview không còn là bản sao dữ liệu production (M3 Task 5).
DB_LOG=

# Giới hạn thời gian (ms) cho mỗi truy vấn của trang (dbQuery, ADR-0011). Số nguyên 100 → 10000; bỏ trống hoặc
# giá trị khác: 5000. Quá giới hạn thì trang lỗi hiện ngay thay vì chờ client kết nối tới 10 giây.
DB_QUERY_TIMEOUT_MS=

# --- Admin (từ M5) ------------------------------------------------------
# Mật khẩu đăng nhập /admin. Bắt buộc từ M5. Tối thiểu 20 ký tự và 16 ký tự khác nhau, tạo bằng: openssl rand -base64 24 (README: "Sinh mật khẩu admin")
# Khác nhau giữa Production và Preview, và khác SESSION_SECRET. Thiếu, ngắn hơn, ít ký tự khác nhau hoặc trùng SESSION_SECRET:
# khu admin đóng (ADR-0018, ADR-0023). Vercel: bật Sensitive. Chỉ ký tự ASCII. Khoảng trắng / xuống dòng ở hai đầu bị bỏ (cả ở
# SESSION_SECRET): dán kèm xuống dòng không khoá admin, nhưng đừng cố ý đặt khoảng trắng ở đầu hay cuối.
ADMIN_PASSWORD=

# Khoá ký cookie phiên admin, tối thiểu 32 ký tự ngẫu nhiên. Khác nhau giữa Production và Preview.
# Tạo bằng: openssl rand -base64 32. Đổi giá trị + redeploy = thu hồi mọi phiên admin của môi trường đó.
SESSION_SECRET=

# --- Thanh toán (từ M6) — xem docs/adr/0004-payment-vietnam.md ---------
# fake (mặc định, không thu tiền) | payos | vnpay | momo (khi mở bán)
PAYMENT_PROVIDER=fake

# Khoá ký webhook của FakeProvider. Bắt buộc từ M6.
# Tạo bằng: openssl rand -base64 32
FAKE_PAYMENT_SECRET=

# Khi mở bán, thêm biến của cổng đã chọn, ví dụ PayOS:
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# --- SEO (từ M3) — src/lib/site-url.ts -----------------------------------
# Origin công khai cho URL tuyệt đối: metadataBase (og:image), sitemap.xml, robots.txt. Tuỳ chọn: chỉ cần khi có
# domain riêng hoặc chạy ngoài Vercel. Đọc LÚC BUILD (sitemap / robots được prerender): đổi giá trị thì phải build lại.
# Dạng https://<host>[:cổng], hoặc http://localhost|127.0.0.1[:cổng] (không dùng cho build production trên Vercel);
# không đường dẫn, query, user. Bỏ trống: Production dùng VERCEL_PROJECT_PRODUCTION_URL, Preview / Dev dùng
# VERCEL_BRANCH_URL rồi VERCEL_URL (Vercel tự đặt), ngoài Vercel dùng http://localhost:3000.
SITE_URL=
